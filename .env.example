# Copy to .env and fill in. Used by docker-compose.yml.

# GitHub token so the `gh` CLI can read release metadata from github.com.
# A fine-grained or classic token with public read access is enough.
GH_TOKEN=

# Host port the UI is published on (container always listens on 8000).
PORT=8000

# Fallback collection title shown when payloads.json has no name yet. A title
# set in the UI is stored in payloads.json and always takes precedence; this is
# just the durable default so the name is never lost.
MIRROR_TITLE=

# Optional login for the UI + management API. Set BOTH to enable it: the UI
# then shows a login screen and the management API requires a session.
# /payloads.json and /api/health always stay public (no auth).
# Leave either empty to keep everything open.
#
# NOTE: the session signing key is derived from these two values, so changing
# the user or the password signs out every open session.
MIRROR_AUTH_USER=
MIRROR_AUTH_PASSWORD=

# Session cookie "Secure" flag: auto (default) | true | false.
#   auto  — set Secure whenever the request arrived over HTTPS. Works behind an
#           HTTPS reverse proxy *and* for direct http://host:PORT access.
#   true  — always Secure. Only use this if the app is reachable via HTTPS
#           exclusively; over plain HTTP the browser silently drops the cookie
#           and the login appears to do nothing.
#   false — never Secure.
MIRROR_COOKIE_SECURE=auto

# Optional "Publish to GitHub" button. Set ALL FOUR to enable it. The button
# commits payloads.json + README.md, runs `git pull --rebase`, then pushes.
# GIT_PASSWORD must be a GitHub Personal Access Token (PAT) with repo write
# access — GitHub no longer accepts account passwords over HTTPS.
GIT_USERNAME=
GIT_PASSWORD=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
